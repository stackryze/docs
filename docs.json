{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Stackryze",
  "description": "Free public subdomains and authoritative PowerDNS hosting — Stackryze Domains and Stackryze DNS.",
  "colors": {
    "primary": "#4FBE7A",
    "light": "#7DD9A1",
    "dark": "#2E7D4F"
  },
  "fonts": {
    "heading": {
      "family": "ApfelGrotezk",
      "source": "/fonts/ApfelGrotezk-Regular.woff2",
      "format": "woff2",
      "weight": 400
    },
    "body": {
      "family": "Inter",
      "source": "/fonts/Inter-Variable.woff2",
      "format": "woff2",
      "weight": 400
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "icon": "book",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart",
              "account-verification"
            ]
          },
          {
            "group": "Stackryze Domains",
            "pages": [
              "docs/domains/index",
              "docs/domains/subdomain-naming",
              "docs/domains/nameserver-delegation",
              "docs/domains/domain-lifecycle",
              "docs/domains/whois-and-availability",
              "docs/domains/security-and-abuse"
            ]
          },
          {
            "group": "Stackryze DNS",
            "pages": [
              "docs/dns/index",
              "docs/dns/zones-and-records",
              "docs/dns/supported-records",
              "docs/dns/nameservers",
              "docs/dns/dnssec",
              "docs/dns/dynamic-dns",
              "docs/dns/api"
            ]
          },
          {
            "group": "Roadmap",
            "pages": [
              "docs/hosting/index"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "icon": "compass",
        "groups": [
          {
            "group": "Stackryze Domains",
            "pages": [
              "guides/domains/getting-started",
              "guides/domains/managing-domains",
              {
                "group": "DNS providers",
                "expanded": false,
                "pages": [
                  "guides/domains/dns-providers",
                  "guides/domains/dns-providers/cloudflare",
                  "guides/domains/dns-providers/route53",
                  "guides/domains/dns-providers/digitalocean",
                  "guides/domains/dns-providers/google-cloud-dns",
                  "guides/domains/dns-providers/azure-dns",
                  "guides/domains/dns-providers/hetzner",
                  "guides/domains/dns-providers/cloudns",
                  "guides/domains/dns-providers/hurricane-electric",
                  "guides/domains/dns-providers/namecheap",
                  "guides/domains/dns-providers/vercel-dns",
                  "guides/domains/dns-providers/desec",
                  "guides/domains/dns-providers/powerdns",
                  "guides/domains/dns-providers/custom"
                ]
              },
              "guides/domains/faq",
              "guides/domains/troubleshooting"
            ]
          },
          {
            "group": "Stackryze DNS",
            "pages": [
              "guides/dns/index",
              "guides/add-a-custom-domain",
              "guides/point-domain-to-stackryze",
              "guides/configure-dns-records",
              "guides/enable-dnssec",
              "guides/dynamic-dns",
              "guides/dns/webhooks-and-edge",
              "guides/dns/troubleshooting",
              "guides/dns/faq"
            ]
